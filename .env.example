# Optional. If JIRA_URL + JIRA_TOKEN are set, the token stays in the Vite dev server
# and the Settings screen is hidden. Leave them empty to enter them in the browser.
JIRA_URL=
JIRA_TOKEN=
# Set to 1 if Jira uses a self-signed / internal CA certificate
JIRA_INSECURE=0
# Dev server port (default 5190)
PORT=5190
